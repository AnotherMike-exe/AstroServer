---
// The berry from the logo, drawn from its own 21 dots so the hero can animate it.
// The dots appear once on page load, top to bottom; reduced motion shows it at rest.
interface Props {
	class?: string;
}
const { class: className } = Astro.props;
---

<svg class:list={['berry', className]} viewBox="-4 -4 442 651" aria-hidden="true" focusable="false">
	<g>
		<circle class="dot" style="--i:0" cx="306.4" cy="232.9" r="31.1" />
		<circle class="dot" style="--i:1" cx="153.3" cy="238.0" r="26.0" />
		<circle class="dot" style="--i:2" cx="228.9" cy="284.5" r="33.4" />
		<circle class="dot" style="--i:3" cx="367.2" cy="303.8" r="27.3" />
		<circle class="dot" style="--i:4" cx="71.4" cy="308.4" r="22.0" />
		<circle class="dot" style="--i:5" cx="152.5" cy="317.8" r="30.0" />
		<circle class="dot" style="--i:6" cx="293.3" cy="342.2" r="30.0" />
		<circle class="dot" style="--i:7" cx="210.7" cy="375.6" r="33.4" />
		<circle class="dot" style="--i:8" cx="400.2" cy="389.6" r="33.0" />
		<circle class="dot" style="--i:9" cx="125.7" cy="403.0" r="36.9" />
		<circle class="dot" style="--i:10" cx="33.2" cy="404.6" r="33.1" />
		<circle class="dot" style="--i:11" cx="321.1" cy="422.6" r="26.7" />
		<circle class="dot" style="--i:12" cx="228.5" cy="451.4" r="27.3" />
		<circle class="dot" style="--i:13" cx="144.5" cy="491.7" r="33.4" />
		<circle class="dot" style="--i:14" cx="386.5" cy="491.9" r="36.9" />
		<circle class="dot" style="--i:15" cx="295.0" cy="504.7" r="33.4" />
		<circle class="dot" style="--i:16" cx="54.4" cy="517.1" r="33.4" />
		<circle class="dot" style="--i:17" cx="213.7" cy="542.8" r="30.4" />
		<circle class="dot" style="--i:18" cx="304.7" cy="589.9" r="32.6" />
		<circle class="dot" style="--i:19" cx="129.6" cy="591.5" r="31.3" />
		<circle class="dot" style="--i:20" cx="218.8" cy="622.8" r="19.5" />
		<path class="leaf" transform="translate(-186 0)" d="M417.5945,185S277.264,200.049,279.3371,46.8516C279.3371,46.8516,418.4122,31.4973,417.5945,185Z" />
		<path class="leaf" transform="translate(-186 0)" d="M428.0315,184.9931S615.3705,205.0824,612.6108.57C612.6108.57,426.9435-19.9295,428.0315,184.9931Z" />
	</g>
</svg>

<style>
	.berry .dot {
		fill: var(--ps-accent);
		transform-box: fill-box;
		transform-origin: center;
	}
	.berry .leaf {
		fill: var(--ps-leaf);
	}
	@media (prefers-reduced-motion: no-preference) {
		.berry .dot {
			animation: pop 520ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
			animation-delay: calc(var(--i) * 45ms + 120ms);
		}
		.berry .leaf {
			transform-box: fill-box;
			transform-origin: bottom center;
			animation: sprout 640ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
			animation-delay: 1100ms;
		}
	}
	@keyframes pop {
		from {
			transform: scale(0);
		}
	}
	@keyframes sprout {
		from {
			transform: scale(0) rotate(-12deg);
		}
	}
</style>
