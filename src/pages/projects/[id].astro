---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusDot from '../../components/StatusDot.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, status, kind, platform, repo, docs } = project.data;
---

<BaseLayout title={title} description={summary}>
	<article class="wrap project">
		<p class="back"><a href="/#projects">All projects</a></p>
		<header>
			<StatusDot status={status} />
			<h1>{title}</h1>
			<p class="summary">{summary}</p>
			<div class="actions">
				{docs && <a class="button primary" href={docs}>Read the docs</a>}
				{repo && <a class="button quiet" href={repo}>Source on GitHub</a>}
			</div>
		</header>

		<div class="layout">
			<div class="prose">
				<Content />
			</div>
			<aside aria-label="Project facts">
				<dl>
					<div>
						<dt>Status</dt>
						<dd>{status}</dd>
					</div>
					<div>
						<dt>Type</dt>
						<dd>{kind}</dd>
					</div>
					<div>
						<dt>Runs on</dt>
						<dd>{platform}</dd>
					</div>
					<div>
						<dt>Source</dt>
						<dd>{repo ? <a href={repo}>{repo.replace('https://github.com/', '')}</a> : 'Not public yet'}</dd>
					</div>
				</dl>
			</aside>
		</div>
	</article>
</BaseLayout>

<style>
	.project {
		padding-top: 2.5rem;
	}
	.back {
		font-family: var(--ps-font-display);
		font-weight: 500;
		font-size: 0.95rem;
	}
	header {
		padding-block: 2.5rem 3rem;
		border-bottom: 2px solid var(--ps-ink);
	}
	h1 {
		margin-top: 0.75rem;
		font-size: clamp(2.6rem, 6vw, 4.2rem);
		font-weight: 750;
		letter-spacing: -0.035em;
	}
	.summary {
		margin-top: 1rem;
		max-width: 40rem;
		font-size: 1.25rem;
		color: var(--ps-ink-soft);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}
	.layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 16rem;
		gap: 3rem 5rem;
		padding-top: 3rem;
	}
	.prose {
		max-width: 40rem;
	}
	aside dl {
		position: sticky;
		top: 6.5rem;
		margin: 0;
		display: grid;
		gap: 1.1rem;
		padding: 1.5rem;
		background: var(--ps-surface);
		border-radius: 1rem;
		font-size: 0.95rem;
	}
	dt {
		color: var(--ps-ink-soft);
		font-size: 0.8rem;
	}
	dd {
		margin: 0;
		overflow-wrap: anywhere;
	}
	@media (max-width: 52rem) {
		.layout {
			grid-template-columns: 1fr;
		}
		aside {
			order: -1;
		}
	}
</style>
