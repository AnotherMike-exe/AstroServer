---
import BaseLayout from '../layouts/BaseLayout.astro';
import { GITHUB_URL } from '../data/Site';
---

<BaseLayout
	title="Store"
	description="The Plum Solutions store is not open yet. Boards, kits and enclosures from our projects will be sold here."
>
	<section class="wrap store">
		<h1>The store is not open yet.</h1>
		<p class="lede">
			Boards, kits and enclosures from our hardware projects will be sold here once each design
			is through testing. Until then, everything we have published is free to build from the
			documentation.
		</p>
		<div class="actions">
			<a class="button primary" href="/#projects">See the projects</a>
			<a class="button quiet" href={GITHUB_URL}>Follow on GitHub</a>
		</div>
	</section>
</BaseLayout>

<style>
	.store {
		padding-block: 6rem 2rem;
	}
	h1 {
		font-size: clamp(2.4rem, 5vw, 3.8rem);
		font-weight: 750;
		letter-spacing: -0.035em;
		max-width: 16ch;
	}
	.lede {
		margin-top: 1.5rem;
		max-width: 36rem;
		font-size: 1.2rem;
		color: var(--ps-ink-soft);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2.25rem;
	}
</style>
